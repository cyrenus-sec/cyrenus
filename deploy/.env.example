# Cyrenus Container / Service Environment Variables
CYRENUS_INTERFACE=eth0
CYRENUS_HTTP_PORT=8181
CYRENUS_BIND_ADDRESS=127.0.0.1
CYRENUS_TRUSTED_PROXY=127.0.0.1
CYRENUS_CORS_ORIGIN=https://cyrenus.example.com
CYRENUS_ENV=production
CYRENUS_LOG_LEVEL=2

# Tetragon Host Security Integration Paths
CYRENUS_TETRAGON_DIR=/etc/tetragon/policies
CYRENUS_POLICY_DIR=/etc/tetragon/policies
CYRENUS_TETRAGON_CONFIG=/etc/tetragon/tetragon.yaml
CYRENUS_TETRAGON_LOG=/var/log/tetragon/tetragon.log


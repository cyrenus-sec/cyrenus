# Cyrenus Hardened Production Configuration
# Copy to /etc/cyrenus/cyrenus.conf and replace credentials/secrets before starting.

interface = "eth0";
http_port = 8181;

# Bind control plane strictly to loopback when terminated by Nginx/Caddy HTTPS proxy.
bind_address = "127.0.0.1";
trusted_proxy = "127.0.0.1";
cors_origin = "https://cyrenus.example.com";

backend = {
    url = "http://localhost";
    api_key = "";
    api_secret = "";
};

username = "admin";
password = "REPLACE_WITH_STRONG_PASSWORD";
app_secret = "REPLACE_WITH_64_CHAR_RANDOM_SECRET";

database = {
    path = "/var/lib/cyrenus/cyrenus.db";
    encrypted = true;
};

geoip = {
    database_path = "/var/lib/cyrenus/GeoLite2-Country.mmdb";
    auto_update = true;
};

# Tuned dual-stack L3/L4 XDP detection and auto-mitigation thresholds
detection = {
    syn_flood_rate = 500;
    synack_flood_rate = 1000;
    rst_flood_rate = 500;
    ack_flood_rate = 2500;
    udp_flood_rate = 5000;
    icmp_flood_rate = 100;
    dns_amp_rate = 200;
    max_frags = 15;
    max_dns_response_size = 2048;
    global_syn_rate = 5000;
    global_udp_rate = 25000;
    auto_block_enabled = 1;
    auto_block_duration_sec = 300;
};

